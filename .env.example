# No credentials belong in git. These are names/placeholders only.
# Export variables in the service environment; .env files are NOT auto-loaded.
MTN_TARGET_ENVIRONMENT=sandbox
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
# Sandbox API user/key or migrated production UserID/Credential Token:
MTN_USER_ID=
MTN_CREDENTIAL_TOKEN=
MTN_COLLECTION_SUBSCRIPTION_KEY=
# Optional registered HTTPS callback base; app appends /{intent_id}.
MTN_CALLBACK_URL=
# Production remains disabled unless explicitly enabled by deployment operator.
QUINCAI_PAYMENTS_LIVE_ENABLED=0
# For Cameroon production use MTN_TARGET_ENVIRONMENT=mtncameroon and the exact
# MTN_BASE_URL confirmed by your account manager for your migration state.
# Orange configuration intentionally omitted: merchant technical contract needed.
