# Supply reviewed Node >=22 image by digest; no mutable default is selected.
ARG NODE_IMAGE
FROM ${NODE_IMAGE} AS build
WORKDIR /build
ARG WEB_APP=web-admin
RUN node -e "if(Number(process.versions.node.split('.')[0])<22)process.exit(1)"
RUN npm install --global pnpm@11.25.0
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps ./apps
COPY packages ./packages
RUN case "$WEB_APP" in web-admin|platform-admin) ;; *) exit 1 ;; esac \
 && pnpm --filter "@quincaisoft/$WEB_APP..." install --frozen-lockfile \
 && pnpm --filter "@quincaisoft/$WEB_APP" exec next build --webpack \
 && mkdir -p "apps/$WEB_APP/public" \
 && test -f "apps/$WEB_APP/.next/standalone/apps/$WEB_APP/server.js"
FROM ${NODE_IMAGE} AS runtime
WORKDIR /opt/quincaisoft
ARG WEB_APP=web-admin
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0 WEB_APP=${WEB_APP}
COPY --from=build --chown=10001:10001 /build/apps/${WEB_APP}/.next/standalone ./
COPY --from=build --chown=10001:10001 /build/apps/${WEB_APP}/.next/static ./apps/${WEB_APP}/.next/static
COPY --from=build --chown=10001:10001 /build/apps/${WEB_APP}/public ./apps/${WEB_APP}/public
COPY --chown=10001:10001 infrastructure/deployment/web-entrypoint.mjs ./web-entrypoint.mjs
USER 10001:10001
EXPOSE 3000
ENTRYPOINT ["node", "/opt/quincaisoft/web-entrypoint.mjs"]
