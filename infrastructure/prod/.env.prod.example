# Copy to .env.prod (same folder) and fill in EVERY value. Never commit .env.prod.
# Generate each password/secret with:  openssl rand -hex 32
# Use hex only (no symbols): these values are placed inside URLs.

DOMAIN=quincaisoft.com
# Used by Let's Encrypt for certificate expiry notices.
ACME_EMAIL=
# Comma/space separated public IPs allowed to open the Keycloak admin console, e.g. 203.0.113.10
ADMIN_IPS=

# Image tag for rollbacks (see docs/DEPLOY.md). "latest" is fine for the first deploy.
TAG=latest

POSTGRES_ADMIN_PASSWORD=
QUINCAI_MIGRATOR_PASSWORD=
QUINCAI_RUNTIME_PASSWORD=
KEYCLOAK_DB_PASSWORD=
REDIS_PASSWORD=

KEYCLOAK_ADMIN_USER=quincai-admin
KEYCLOAK_ADMIN_PASSWORD=

# Client secrets for the two Keycloak clients created by the realm import.
QUINCAI_WEB_CLIENT_SECRET=
QUINCAI_PLATFORM_CLIENT_SECRET=
