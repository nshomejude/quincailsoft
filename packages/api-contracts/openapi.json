{
  "openapi": "3.1.0",
  "info": {
    "title": "QuincaiSoft Java migration API",
    "version": "0.1.0",
    "description": "Source-backed migration slice only. This contract does not imply all canonical endpoint families are implemented. JWT issuer, audience and current database membership are verified. Tenant/company/branch headers cannot override token scope. Canonical authority: Master Architecture v2 \u00a7\u00a75,7,31\u201346."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/session": {
      "get": {
        "summary": "Inspect current authenticated scope and authorities",
        "responses": {
          "200": {
            "description": "Current scoped result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "Bearer authentication missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Scope, current membership or permission denied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error; correlation ID supplied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "deprecated": true,
        "description": "Compatibility alias for /me; both currently implemented."
      }
    },
    "/products": {
      "get": {
        "summary": "List up to 200 scoped products, ordered by SKU",
        "responses": {
          "200": {
            "description": "Current scoped result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Product"
                  },
                  "maxItems": 200
                }
              }
            }
          },
          "401": {
            "description": "Bearer authentication missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Scope, current membership or permission denied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error; correlation ID supplied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-permission": "SCOPE_catalog:read"
      }
    },
    "/products/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "Read a scoped product",
        "responses": {
          "200": {
            "description": "Current scoped result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "401": {
            "description": "Bearer authentication missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Scope, current membership or permission denied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Record not found in active scope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error; correlation ID supplied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-permission": "SCOPE_catalog:read"
      }
    },
    "/sales": {
      "get": {
        "summary": "List up to 100 sales in the active branch",
        "responses": {
          "200": {
            "description": "Current scoped result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Sale"
                  },
                  "maxItems": 100
                }
              }
            }
          },
          "401": {
            "description": "Bearer authentication missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Scope, current membership or permission denied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error; correlation ID supplied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-permission": "sales:read",
        "x-permission-any": [
          "sales:read",
          "SCOPE_sales:read"
        ]
      },
      "post": {
        "summary": "Create an atomic sale draft with current catalog prices",
        "x-permission": "sales:write",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Must equal body.operationId. The same intended command must retain this key across retries."
          },
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Request tracing ID; distinct from durable operation identity."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftSale"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current scoped result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sale"
                }
              }
            }
          },
          "400": {
            "description": "Malformed header or JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Current scope, membership or permission denied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Scoped source does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Operation identity reused, unavailable stock or invalid current state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "412": {
            "description": "Expected sale version differs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Business data, exact quantity or amount is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error; correlation ID supplied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Creates DRAFT only; no stock, finance or payment posting. Requires eligible customer and warehouse in active scope. One line per product, active zero-tax catalog products and exact integral XAF line totals are required in this bounded slice.",
        "x-permission-any": [
          "sales:write",
          "SCOPE_sales:write"
        ]
      }
    },
    "/sales/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "Read a scoped sale",
        "responses": {
          "200": {
            "description": "Current scoped result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sale"
                }
              }
            }
          },
          "401": {
            "description": "Bearer authentication missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Scope, current membership or permission denied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Record not found in active scope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error; correlation ID supplied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-permission": "sales:read",
        "x-permission-any": [
          "sales:read",
          "SCOPE_sales:read"
        ]
      }
    },
    "/sales/{id}/post": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "summary": "Post a bounded zero-tax immediate credit sale",
        "x-permission": "sales:post",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Must equal body.operationId. The same intended command must retain this key across retries."
          },
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Request tracing ID; distinct from durable operation identity."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostSale"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Current scoped result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sale"
                }
              }
            }
          },
          "400": {
            "description": "Malformed header or JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Current scope, membership or permission denied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Scoped source does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Operation identity reused, unavailable stock or invalid current state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "412": {
            "description": "Expected sale version differs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Business data, exact quantity or amount is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error; correlation ID supplied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Coordinates stock issue, balanced operational AR/revenue and COGS/inventory postings, sale finality and outbox. This initial slice does not implement cash/mobile-money settlement, tax-bearing sales, document issuance or the complete canonical sales workflow. Read migration-to-canonical.md before enabling.",
        "x-permission-any": [
          "sales:post",
          "SCOPE_sales:post"
        ]
      }
    },
    "/me": {
      "get": {
        "summary": "Inspect current authenticated scope and authorities",
        "responses": {
          "200": {
            "description": "Current scoped result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "Bearer authentication missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Scope, current membership or permission denied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error; correlation ID supplied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "External OIDC access token. UUID sub, tenant_id, company_id, branch_id and integer authorization_epoch; required issuer/audience; active DB membership must match scope and epoch."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "reason"
              ]
            }
          },
          "retryable": {
            "type": "boolean"
          },
          "currentVersion": {
            "type": [
              "integer",
              "null"
            ]
          },
          "helpKey": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "code",
          "message",
          "correlationId",
          "retryable"
        ]
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "baseUnit": {
            "type": "string"
          },
          "sellingPriceXaf": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "description": "Exact nonnegative integer encoded as a decimal string. XAF has one-FCFA units; quantityMilli has one-thousandth base-unit units."
          },
          "taxBasisPoints": {
            "type": "integer"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "description": "Exact nonnegative integer encoded as a decimal string. XAF has one-FCFA units; quantityMilli has one-thousandth base-unit units."
          },
          "active": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "sku",
          "name",
          "baseUnit",
          "sellingPriceXaf",
          "taxBasisPoints",
          "version",
          "active"
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "object",
            "properties": {
              "tenantId": {
                "type": "string",
                "format": "uuid"
              },
              "companyId": {
                "type": "string",
                "format": "uuid"
              },
              "branchId": {
                "type": "string",
                "format": "uuid"
              },
              "actorId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "tenantId",
              "companyId",
              "branchId",
              "actorId"
            ]
          },
          "authorities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "scope",
          "authorities"
        ]
      },
      "SaleLine": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "quantityMilli": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "description": "Exact nonnegative integer encoded as a decimal string. XAF has one-FCFA units; quantityMilli has one-thousandth base-unit units."
          },
          "unitPriceXaf": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "description": "Exact nonnegative integer encoded as a decimal string. XAF has one-FCFA units; quantityMilli has one-thousandth base-unit units."
          },
          "lineTotalXaf": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "description": "Exact nonnegative integer encoded as a decimal string. XAF has one-FCFA units; quantityMilli has one-thousandth base-unit units."
          }
        },
        "required": [
          "id",
          "productId",
          "quantityMilli",
          "unitPriceXaf",
          "lineTotalXaf"
        ]
      },
      "Sale": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "HELD",
              "POSTED",
              "PARTIALLY_RETURNED",
              "FULLY_RETURNED",
              "VOIDED_BEFORE_POST"
            ]
          },
          "businessDate": {
            "type": "string",
            "format": "date"
          },
          "totalXaf": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "description": "Exact nonnegative integer encoded as a decimal string. XAF has one-FCFA units; quantityMilli has one-thousandth base-unit units."
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "warehouseId": {
            "type": "string",
            "format": "uuid"
          },
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SaleLine"
            }
          }
        },
        "required": [
          "id",
          "status",
          "businessDate",
          "totalXaf",
          "version",
          "warehouseId",
          "customerId",
          "lines"
        ]
      },
      "DraftSale": {
        "type": "object",
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "warehouseId": {
            "type": "string",
            "format": "uuid"
          },
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "businessDate": {
            "type": "string",
            "format": "date"
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
              "type": "object",
              "properties": {
                "productId": {
                  "type": "string",
                  "format": "uuid"
                },
                "quantityMilli": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                }
              },
              "required": [
                "productId",
                "quantityMilli"
              ]
            }
          }
        },
        "required": [
          "operationId",
          "warehouseId",
          "customerId",
          "businessDate",
          "lines"
        ]
      },
      "PostSale": {
        "type": "object",
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "operationId",
          "version",
          "reason"
        ]
      }
    }
  }
}
