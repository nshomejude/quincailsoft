# Public site origin used for canonical URLs, sitemap, hreflang and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://quincaisoft.com
# TODO(Opesware): confirm the real inbox before launch.
NEXT_PUBLIC_CONTACT_EMAIL=contact@quincaisoft.com

# Contact/demo form email (server-side only; never NEXT_PUBLIC_). All four are required for the form to send.
SMTP_HOST=
SMTP_PORT=587
# Leave SMTP_SECURE empty: true is implied for port 465, STARTTLS is used otherwise.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# From must be an address your SMTP provider is allowed to send as (verified domain).
CONTACT_FROM="QuincaiSoft website <no-reply@quincaisoft.com>"
# SaaS admin inbox(es), comma separated.
CONTACT_TO=
