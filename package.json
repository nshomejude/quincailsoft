{
  "name": "quincaisoft",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @quincaisoft/web-admin dev",
    "build:web": "pnpm --filter @quincaisoft/web-admin build",
    "check:web": "pnpm --filter @quincaisoft/web-admin typecheck",
    "test:backend": "cd backend && ./mvnw verify",
    "legacy:demo": "python3 server/server.py --demo --data-dir runtime/v5",
    "legacy:test": "python3 -m unittest discover -s tests -v",
    "check:rules": "node scripts/check-project-rules.mjs",
    "check:parity": "node scripts/check-python-java-parity.mjs",
    "inventory:parity": "node scripts/inventory-python-parity.mjs",
    "test:project-gates": "node --test scripts/project-gates.test.mjs"
  }
}
